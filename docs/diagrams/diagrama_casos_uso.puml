@startuml diagrama_casos_uso

' Notação, fronteira do sistema e paleta próximas da baseline.
left to right direction
skinparam monochrome false
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam actorStyle stickman
skinparam ArrowColor black
skinparam ArrowThickness 1.2
skinparam usecaseBorderColor black
skinparam usecaseFontColor black
skinparam actorBackgroundColor #55C8EC
skinparam actorBorderColor black
skinparam actorFontColor black
skinparam packageBorderColor #333333
skinparam packageFontColor black
skinparam rectangleBorderColor black
skinparam rectangleFontColor black
skinparam nodesep 35
skinparam ranksep 35

title Diagrama de Casos de Uso — PictuRAS (Baseline + Vídeo)

' Utilizador representa o perfil autenticado Registado.
' Premium e Convidado são especializações e herdam as associações do ator base.
' Anónimo permanece independente: não pode aceder às funcionalidades de vídeo.
actor "Anónimo" as Anonimo
actor "Utilizador Convidado" as Convidado
actor "Utilizador\n(Registado)" as Utilizador
actor "Premium" as Premium

Convidado -right-|> Utilizador
Premium -down-|> Utilizador

rectangle "Sistema" {
  package "Casos de uso da baseline" as Baseline #F1F1F1 {
    usecase "Registo" as UC_Registo #D9D9D9
    usecase "Login" as UC_Login #D9D9D9
    usecase "Carregar imagens" as UC_CarregarImagens #D9D9D9
    usecase "Aplicar encadeamento de ferramentas\na conjunto de imagens" as UC_EncadeamentoImagens #D9D9D9
    usecase "Criar filtro personalizado" as UC_FiltroPersonalizado #D9D9D9
    usecase "Partilhar projeto" as UC_Partilhar #D9D9D9
    usecase "Assistente IA na edição" as UC_AssistenteIA #D9D9D9
  }

  package "Extensão de vídeo" as Video #EAF8FD {
    package "Ciclo de vida e acesso" as Ciclo #F7FCFE {
      usecase "UC-VID-000\nCarregar e visualizar vídeo" as UC_VID_000 #55C8EC
      usecase "UC-VID-005\nDescarregar vídeo" as UC_VID_005 #55C8EC
      usecase "UC-VID-006\nConsultar informações do vídeo" as UC_VID_006 #55C8EC
    }

    package "Edição temporal e marca de água" as Temporal #F7FCFE {
      usecase "UC-VID-001\nRecortar vídeo" as UC_VID_001 #55C8EC
      usecase "UC-VID-002\nRemover áudio" as UC_VID_002 #55C8EC
      usecase "UC-VID-003\nAlterar velocidade" as UC_VID_003 #55C8EC
      usecase "UC-VID-004\nAplicar marca de água" as UC_VID_004 #55C8EC
    }

    package "Edição visual e formato" as Visual #F7FCFE {
      usecase "UC-VID-007\nAjustar propriedades visuais" as UC_VID_007 #55C8EC
      usecase "UC-VID-008\nAplicar filtro visual" as UC_VID_008 #55C8EC
      usecase "UC-VID-009\nRedimensionar vídeo" as UC_VID_009 #55C8EC
      usecase "UC-VID-010\nRodar e espelhar vídeo" as UC_VID_010 #55C8EC
      usecase "UC-VID-011\nConverter formato" as UC_VID_011 #55C8EC
    }

    package "Composição e processamento" as Composicao #F7FCFE {
      usecase "UC-VID-012\nJuntar vídeos" as UC_VID_012 #55C8EC
      usecase "UC-VID-013\nEncadear operações" as UC_VID_013 #55C8EC
    }
  }
}

' Acesso anónimo apenas a registo e autenticação.
Anonimo -- UC_Registo
Anonimo -- UC_Login

' Associações da baseline.
Utilizador -- UC_CarregarImagens
Utilizador -- UC_EncadeamentoImagens
Utilizador -- UC_FiltroPersonalizado
Utilizador -- UC_Partilhar
Premium -- UC_AssistenteIA

' Associações de vídeo no ator base: os perfis especializados herdam-nas.
Utilizador -- UC_VID_000
Utilizador -- UC_VID_001
Utilizador -- UC_VID_002
Utilizador -- UC_VID_003
Utilizador -- UC_VID_004
Utilizador -- UC_VID_005
Utilizador -- UC_VID_006
Utilizador -- UC_VID_007
Utilizador -- UC_VID_008
Utilizador -- UC_VID_009
Utilizador -- UC_VID_010
Utilizador -- UC_VID_011
Utilizador -- UC_VID_012
Utilizador -- UC_VID_013

legend bottom
  |= Marca |= Perfil e permissões |
  |<#D9D9D9> Cinzento | Casos de uso da baseline |
  |<#55C8EC> Azul | Novos casos de uso de vídeo |
  | Anónimo | Registo/login; sem acesso a vídeo |
  | Utilizador (Registado) | Autenticado; edição exige permissão de edição no projeto; até 5 min / 200 MB e 5 créditos/dia |
  | Premium → Utilizador | Herda associações; sem quota diária; até 60 min / 2 GB |
  | Convidado → Utilizador | Herda após convite; projeto determina leitura/edição; quota debitada à conta executora |
  | UC-VID-005/006 | Leitura ou superior; todos os restantes casos de vídeo exigem edição |
endlegend

@enduml
