@startuml diagrama_casos_uso
skinparam monochrome false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
}

' Casos de uso da baseline (Imagem / Geral)
skinparam usecase {
    BackgroundColor #E1F5FE
    BorderColor #0277BD
    FontSize 11
}

' Casos de uso novos da Fase 1 (Vídeo)
skinparam usecase<<VideoExtension>> {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    BorderThickness 1.5
}

title Diagrama de Casos de Uso Consolidado — PictuRAS v27.1 (Fase 1: Suporte a Vídeo)

' ==========================================
' ATORES
' ==========================================
actor "Anónimo" as Anonimo
actor "Utilizador autenticado" as Utilizador
actor "Registado / Gratuito" as Registado
actor "Utilizador Convidado" as Convidado
actor "Premium" as Premium

Utilizador <|-- Registado
Utilizador <|-- Premium

' ==========================================
' SISTEMA PICTURAS
' ==========================================
rectangle "Sistema PictuRAS" {

    ' Casos de uso gerais / Imagem (Baseline)
    package "Casos de Uso da Baseline (Geral e Imagem)" #F9FBE7 {
        usecase "Registo" as UC_Registo
        usecase "Login" as UC_Login
        usecase "Partilhar projeto" as UC_Partilhar
        usecase "Carregar imagens" as UC_CarregarImagens
        usecase "Criar filtro personalizado" as UC_FiltroPersonalizado
        usecase "Aplicar encadeamento de\nferramentas a imagens" as UC_EncadeamentoImagens
        usecase "Assistente IA na edição" as UC_AssistenteIA
    }

    ' Casos de uso da Extensão de Vídeo (Fase 1)
    package "Extensão de Vídeo Digital (Fase 1 — MVP)" #FFFDE7 {
        usecase "UC-VID-000\nCarregar e visualizar\nvídeo no projeto" as UC_VID_000 <<VideoExtension>>
        usecase "UC-VID-001\nRecortar temporalmente\num vídeo (trim)" as UC_VID_001 <<VideoExtension>>
        usecase "UC-VID-002\nRemover o áudio\nde um vídeo" as UC_VID_002 <<VideoExtension>>
        usecase "UC-VID-003\nAlterar a velocidade\nde reprodução" as UC_VID_003 <<VideoExtension>>
        usecase "UC-VID-004\nAplicar marca de água\na um vídeo" as UC_VID_004 <<VideoExtension>>
        usecase "UC-VID-005\nExtrair fotogramas\npara o projeto" as UC_VID_005 <<VideoExtension>>
        usecase "UC-VID-006\nDescarregar vídeo\ndo projeto" as UC_VID_006 <<VideoExtension>>
        usecase "UC-VID-007\nConsultar informações\ndo vídeo" as UC_VID_007 <<VideoExtension>>
        usecase "UC-VID-008\nAjustar propriedades\nvisuais" as UC_VID_008 <<VideoExtension>>
        usecase "UC-VID-009\nAplicar filtro visual\na um vídeo" as UC_VID_009 <<VideoExtension>>
        usecase "UC-VID-010\nRedimensionar\nvídeo" as UC_VID_010 <<VideoExtension>>
        usecase "UC-VID-011\nRodar e espelhar\nvídeo" as UC_VID_011 <<VideoExtension>>
        usecase "UC-VID-012\nConverter formato\nde vídeo" as UC_VID_012 <<VideoExtension>>
        usecase "UC-VID-013\nJuntar vídeos" as UC_VID_013 <<VideoExtension>>
        usecase "UC-VID-014\nEncadear operações\nde vídeo" as UC_VID_014 <<VideoExtension>>
        usecase "UC-VID-015\nProcessar vídeos\nem lote" as UC_VID_015 <<VideoExtension>>
    }

    ' A disponibilidade do vídeo no projeto é pré-condição, não inclusão do upload.

    ' Ponte entre vídeo e ferramentas de imagem existentes
    UC_VID_005 ..> UC_EncadeamentoImagens : <<extend>>\n(fotogramas alimentam\nferramentas de imagem)
}

' ==========================================
' ASSOCIAÇÕES ATORES -> CASOS DE USO
' ==========================================
Anonimo --> UC_Registo
Anonimo --> UC_Login

Utilizador --> UC_Partilhar
Utilizador --> UC_CarregarImagens
Utilizador --> UC_FiltroPersonalizado
Utilizador --> UC_EncadeamentoImagens

' Acesso ao subsistema de vídeo reservado a Utilizadores autenticados
Utilizador --> UC_VID_000
Utilizador --> UC_VID_001
Utilizador --> UC_VID_002
Utilizador --> UC_VID_003
Utilizador --> UC_VID_004
Utilizador --> UC_VID_005
Utilizador --> UC_VID_006
Utilizador --> UC_VID_007
Utilizador --> UC_VID_008
Utilizador --> UC_VID_009
Utilizador --> UC_VID_010
Utilizador --> UC_VID_011
Utilizador --> UC_VID_012
Utilizador --> UC_VID_013
Utilizador --> UC_VID_014
Utilizador --> UC_VID_015

Premium --> UC_AssistenteIA

note right of UC_VID_000
  <b>Upload e Visualização (UC-VID-000):</b>
  Isento de débito de quota diária (DQ-011).
  Apenas utilizadores Registados e Premium
  podem carregar e aceder a vídeos.
end note

note right of Convidado
  O <b>Utilizador Convidado</b> herda
  as permissões do Utilizador normal
  a partir do momento que é convidado
  via link com permissão de edição.
  A quota é debitada ao convidado (DQ-008).
end note

note right of UC_VID_014
  Cadeias: até 10 passos;
  conversão apenas no fim;
  sem extração de fotogramas.
end note

note left of UC_VID_000
  As operações seguintes requerem
  um vídeo acessível no projeto;
  não obrigam a carregar outro vídeo.
end note

note bottom of UC_VID_015
  Lotes processam sequencialmente.
  Junção e extração não são elegíveis.
end note

@enduml

