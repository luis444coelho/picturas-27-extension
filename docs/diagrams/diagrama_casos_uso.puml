@startuml diagrama_casos_uso
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam actorStyle stickman
skinparam usecaseBackgroundColor #55C8EC
skinparam usecaseBorderColor black
skinparam actorBackgroundColor #55C8EC
skinparam actorBorderColor black
skinparam ArrowColor black
skinparam ArrowThickness 1.2
skinparam noteBackgroundColor #55C8EC
skinparam noteBorderColor black
skinparam nodesep 35
skinparam ranksep 40
left to right direction

title Diagrama de Casos de Uso — PictuRAS (Baseline + Vídeo)

' Atores e generalizações da baseline
actor "Anónimo" as Anonimo
actor "Utilizador" as Utilizador
actor "Utilizador Convidado" as Convidado
actor "Registado / Gratuito" as Gratuito
actor "Premium" as Premium
actor "Utilizador autorizado para vídeo\n(Registado / Premium)" as UtilizadorVideo

Utilizador <|-- Anonimo
Utilizador <|-- Convidado
Utilizador <|-- Gratuito
Utilizador <|-- Premium
UtilizadorVideo <|-- Gratuito
UtilizadorVideo <|-- Premium

rectangle "Sistema" {
  usecase "Registo" as UC_Registo
  usecase "Login" as UC_Login
  usecase "Carregar imagens" as UC_CarregarImagens
  usecase "Aplicar encadeamento de ferramentas\na conjunto de imagens" as UC_EncadeamentoImagens
  usecase "Criar filtro personalizado" as UC_FiltroPersonalizado
  usecase "Partilhar projeto" as UC_Partilhar
  usecase "Assistente IA na edição" as UC_AssistenteIA

  usecase "UC-VID-000\nCarregar e visualizar vídeo" as UC_VID_000
  usecase "UC-VID-001\nRecortar vídeo (trim)" as UC_VID_001
  usecase "UC-VID-002\nRemover áudio" as UC_VID_002
  usecase "UC-VID-003\nAlterar velocidade" as UC_VID_003
  usecase "UC-VID-004\nAplicar marca de água" as UC_VID_004
  usecase "UC-VID-005\nExtrair fotogramas para o projeto" as UC_VID_005
  usecase "UC-VID-006\nDescarregar vídeo" as UC_VID_006
  usecase "UC-VID-007\nConsultar informações do vídeo" as UC_VID_007
  usecase "UC-VID-008\nAjustar propriedades visuais" as UC_VID_008
  usecase "UC-VID-009\nAplicar filtro visual" as UC_VID_009
  usecase "UC-VID-010\nRedimensionar vídeo" as UC_VID_010
  usecase "UC-VID-011\nRodar e espelhar vídeo" as UC_VID_011
  usecase "UC-VID-012\nConverter formato" as UC_VID_012
  usecase "UC-VID-013\nJuntar vídeos" as UC_VID_013
  usecase "UC-VID-014\nEncadear operações" as UC_VID_014
  usecase "UC-VID-015\nProcessar vídeos em lote" as UC_VID_015
}

' Casos de uso da baseline
Anonimo -- UC_Registo
Anonimo -- UC_Login
Utilizador -- UC_CarregarImagens
Utilizador -- UC_EncadeamentoImagens
Utilizador -- UC_FiltroPersonalizado
Utilizador -- UC_Partilhar
Premium -- UC_AssistenteIA

' Apenas perfis Registado e Premium acedem aos casos de uso de vídeo.
UtilizadorVideo -- UC_VID_000
UtilizadorVideo -- UC_VID_001
UtilizadorVideo -- UC_VID_002
UtilizadorVideo -- UC_VID_003
UtilizadorVideo -- UC_VID_004
UtilizadorVideo -- UC_VID_005
UtilizadorVideo -- UC_VID_006
UtilizadorVideo -- UC_VID_007
UtilizadorVideo -- UC_VID_008
UtilizadorVideo -- UC_VID_009
UtilizadorVideo -- UC_VID_010
UtilizadorVideo -- UC_VID_011
UtilizadorVideo -- UC_VID_012
UtilizadorVideo -- UC_VID_013
UtilizadorVideo -- UC_VID_014
UtilizadorVideo -- UC_VID_015

' Os fotogramas extraídos passam a ser imagens do projeto.
UC_VID_005 ..> UC_EncadeamentoImagens : <<extend>>

note right of UC_VID_000
  O utilizador autenticado carrega um vídeo
  para um projeto com permissão de edição.
  Upload e reprodução não consomem quota.
end note

note right of UC_VID_014
  Cadeia: até 10 passos; conversão no fim;
  sem extração de fotogramas.
end note

note right of UC_VID_015
  Lote: 2–10 vídeos (Registado), 2–50 (Premium).
  Processamento sequencial; sem junção ou extração.
end note

@enduml
