@startuml arquitetura_componentes
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam actorBorderColor black
skinparam sequenceLifeLineBorderColor #777777
skinparam sequenceArrowColor black
skinparam queueBorderColor black
skinparam sequenceQueueBorderColor black
skinparam ArrowThickness 1.2
skinparam noteBackgroundColor #FFF4CF
skinparam noteBorderColor #8A6D2B
top to bottom direction
skinparam componentStyle rectangle
skinparam componentBackgroundColor #55C8EC
skinparam componentBorderColor black
skinparam databaseBackgroundColor #D9D9D9
skinparam nodesep 45
skinparam ranksep 55
title Componentes — suporte a vídeo implementado (incluindo Bolt 008)
component "Frontend\nEdição simples / várias operações\nJunção / Movie Maker / predefinições" as UI
component "Nginx\nHTTPS / proxy" as Nginx #D9D9D9
component "API Gateway\nJWT / rotas de vídeo\nValidação de predefinições" as API
component "Projetos\nAutorização / estrutura / estimativas\nPlano / tarefa / resultado" as Projects
component "Utilizadores\nQuota / identidade\nPredefinições de vídeo" as Users
database "MongoDB\nBases próprias por serviço" as DB
queue "RabbitMQ\nFilas de vídeo e video_control" as MQ #D9D9D9
component "Worker de vídeo\nGenérico / conversão / composição\nFFmpeg / FFprobe" as Worker
component "imageStorageService\nURLs e gestão de objetos" as Storage
component "WS Gateway\nEventos de tarefa / ingestão" as WS
cloud "SeaweedFS / S3\nOriginais / resultados\nMiniaturas / cópias MP4" as S3 #D9D9D9
UI --> Nginx : HTTPS / WebSocket
Nginx --> API : API
Nginx --> WS : WebSocket
Nginx --> S3 : Assinatura / Range
API --> Projects : Vídeo / composição\nestrutura de predefinições
API --> Users : CRUD de predefinições\napós validação em Projetos
Projects --> Users : Perfil / reserva / devolução
Projects --> DB : Vídeos / tarefas / locks
Users --> DB : Contas / quotas / predefinições
Projects <--> MQ : Pedidos / respostas\ncontrolo / estados
MQ <--> Worker : Plano / progresso / resposta
MQ --> WS : Eventos
Projects --> Storage : Chaves / URLs / limpeza
Worker --> Storage : URLs internos quando necessários
Worker --> S3 : GET / PUT por blocos
Storage --> S3 : Assinar / gerir objetos
legend bottom
  Azul: módulos de vídeo acrescentados aos serviços; worker de vídeo.
  Cinzento: infraestrutura existente reutilizada.
endlegend
@enduml
