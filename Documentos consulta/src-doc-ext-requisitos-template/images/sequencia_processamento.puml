@startuml sequencia_processamento
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam sequenceParticipantFontSize 17
skinparam participantBackgroundColor #55C8EC
skinparam participantBorderColor black
skinparam actorBackgroundColor #55C8EC
skinparam actorBorderColor black
skinparam sequenceArrowColor black
skinparam sequenceLifeLineBorderColor black
skinparam sequenceQueueBorderColor black
skinparam sequenceGroupBorderColor black
skinparam sequenceGroupBackgroundColor #F7FCFE
skinparam sequenceGroupHeaderFontColor black
skinparam noteBackgroundColor #F7FCFE
skinparam noteBorderColor black
skinparam ArrowThickness 1.2
skinparam ParticipantPadding 15
skinparam BoxPadding 10
hide footbox
autonumber

title Sequência — Processar um Vídeo no Projeto\nTransformação implementada; composição completa prevista no Bolt 008

actor "Utilizador\nFrontend" as UI
participant "API Gateway\n(via Nginx)" as API
participant "Projetos\nOrquestrador" as Projects
participant "Utilizadores\nQuota" as Users #D9D9D9
participant "RabbitMQ\nFilas de vídeo" as MQ #D9D9D9
participant "Worker\nFFmpeg / FFprobe" as Worker
participant "Storage\nMódulo de vídeo + S3" as Storage #D9D9D9
participant "WS Gateway\nMódulo de vídeo" as WS

group Admissão e resposta assíncrona
  UI -> API : POST .../operations\n{steps}
  API -> Projects : JWT validado; X-Caller-Id\nX-Correlation-Id
  Projects -> Projects : Verificar permissão e perfil\nLer metadados; validar passos\nEstimar plano e custo
  Projects -> Projects : Adquirir lugar por projeto\nPersistir lock (MongoDB)
  opt Conta Registada (Premium não reserva quota)
    Projects -> Users : Reservar N créditos\nGET /:user/process/:n
    Users --> Projects : Reserva debitada
  end
  Projects -> Projects : Persistir VideoTask com estado queued
  Projects ->> MQ : video_operations_queue\n{taskId, correlationId, plano, chaves}
  note right of Projects
    Se a publicação falhar, a tarefa persiste queued
    com published_at nulo; recuperação republica (D-41).
  end note
  Projects --> API : 202 {taskId, status: queued}
  API --> UI : Pedido aceite; taskId
end

newpage Execução fora do pedido HTTP

group Execução fora do pedido HTTP
  MQ ->> Worker : Entregar pedido (ack manual)
  Worker ->> MQ : video_project_queue: started
  MQ ->> Projects : started(taskId)
  Projects -> Projects : Persistir processing
  Projects -> MQ : ACK da resposta após persistência
  Projects ->> MQ : video_ws_queue: processing
  MQ ->> WS : Transição para processing
  WS ->> UI : video-task-update (processing)
  Worker -> Storage : Pedir URL GET interno
  Storage --> Worker : URL assinado
  Worker -> Storage : GET S3 por blocos
  Worker -> Worker : Executar plano FFmpeg\nNo máximo uma codificação do vídeo final
  loop Progresso pelo menos 1 vez por segundo
    Worker ->> MQ : video_ws_queue\n{taskId, step, totalSteps, progress}
    MQ ->> WS : Evento de progresso
    WS ->> UI : video-task-update\nSala do executor e do projeto
  end
  Worker -> Worker : FFprobe; miniatura; fotograma 0\nCópia MP4 se necessária
  Worker -> Storage : Pedir URLs PUT internos\nEnviar resultado e artefactos
  Worker ->> MQ : video_project_queue: completed\n{taskId, meta, chaves}
  Worker -> MQ : ACK do pedido após resposta
end

newpage Publicação do resultado

group Publicação do resultado
  MQ ->> Projects : completed(taskId, meta, chaves)
  Projects -> Projects : Persistir completed\nCriar vídeo com proveniência (ID = taskId)\nLibertar lugar; sem novo débito de quota
  Projects -> MQ : ACK da resposta após persistência
  Projects ->> MQ : video_ws_queue: completed\n{taskId, resultVideoId, status}
  MQ ->> WS : Evento de conclusão
  WS ->> UI : video-task-update\nResultado disponível
end

note over Projects, Worker
  MongoDB é atualizado pelo serviço de Projetos.
  O worker devolve metadados reais e chaves de objetos.
  O ID determinístico evita duplicar o recurso em reentrega.
  Não existe transação distribuída entre MongoDB, quota e S3.
end note
note over UI, Projects
  Falhas, cancelamento e reentrega seguem a máquina de estados.
  Pedidos rejeitados antes da admissão não entram nesta sequência.
end note
@enduml
