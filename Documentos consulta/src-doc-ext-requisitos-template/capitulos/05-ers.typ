    [#text("REQ-VID-SPEED-008")], [#text("O sistema deve preservar no vídeo gerado com alteração de velocidade a resolução espacial nativa, gerando-o em MP4 (H.264/AAC) independentemente do formato de origem (MP4, MOV ou AVI).; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-003 (Passo 5, RN4, DQ-002, DQ-013)")], [#text("Garante que a geometria do quadro e a compatibilidade do reprodutor se mantêm inalteradas.")], [#text("Dado um vídeo de origem MP4 ou MOV em 1080p, Quando o processamento de velocidade conclui, Então o resultado é um MP4 H.264/AAC que conserva integralmente a resolução 1920×1080 px.")],
    [#text("REQ-VID-TRIM-001")], [#text("O sistema deve permitir ao utilizador registado ou premium definir o instante inicial do recorte temporal em horas, minutos, segundos e milissegundos.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-001 (Passos 2-3)")], [#text("Ponto de partida elementar para delimitação precisa do segmento de vídeo a conservar.")], [#text("Dado o ecrã de recorte, Quando o utilizador introduz o valor 00:00:10.500, Então o instante inicial fica configurado exatamente com esse timestamp.")],
    [#text("REQ-VID-TRIM-002")], [#text("O sistema deve permitir ao utilizador registado ou premium definir o instante final do recorte temporal em horas, minutos, segundos e milissegundos.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-001 (Passos 2-3)")], [#text("Ponto de fecho elementar para delimitação precisa do segmento de vídeo a conservar.")], [#text("Dado o ecrã de recorte, Quando o utilizador introduz o valor 00:00:45.000, Então o instante final fica configurado exatamente com esse timestamp.")],
    [#text("REQ-VID-TRIM-003")], [#text("O sistema deve sincronizar os seletores temporais de recorte com a posição de reprodução corrente do leitor integrado (scrubbing).; Evolução: Novo")], [#should], [#text("NOVO")], [#text("UC-VID-001 (Passo 3)")], [#text("Facilita a escolha exata dos pontos de corte permitindo marcar o instante atual da reprodução.")], [#text("Dado o leitor pausado aos 00:15.20, Quando o utilizador clica em \"Definir Início\", Então o instante inicial de corte é preenchido de imediato com 00:15.20.")],
    [#text("REQ-VID-TRIM-004")], [#text("O sistema deve apresentar em tempo real a duração estimada do segmento resultante com base na diferença entre o instante final e o instante inicial.; Evolução: Mantido")], [#should], [#text("NOVO")], [#text("UC-VID-001 (Passo 3, FA1)")], [#text("Fornece feedback imediato ao utilizador sobre o tamanho do segmento temporal resultante.")], [#text("Dado o instante inicial 00:10 e o instante final 00:35, Quando os valores são alterados, Então a interface exibe instantaneamente a duração prevista de 25 segundos.")],
    [#text("REQ-VID-TRIM-005")], [#text("O sistema deve rejeitar intervalos de recorte em que o instante inicial seja estritamente maior ou igual ao instante final.; Evolução: Mantido")], [#must], [#text("NOVO")], [#text("UC-VID-001 (Exceção 1, RN2)")], [#text("Impede a produção de ficheiros com duração nula, negativa ou matematicamente inconsistente.")], [#text("Dado o início em 00:30 e o fim em 00:20, Quando o utilizador tenta confirmar, Então o botão de confirmação é bloqueado indicando intervalo invertido.")],
