    [#text("REQ-VID-UPLOAD-018")], [#text("O sistema deve apresentar em tempo real o progresso percentual da transferência do vídeo entre 0% e 100%.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 3)")], [#text("Dá visibilidade ao utilizador sobre o avanço da transferência.")], [#text("Dado um carregamento em curso, Quando os dados são transmitidos, Então a interface atualiza monotonicamente o progresso percentual até 100%.")],
    [#text("REQ-VID-UPLOAD-006")], [#text("O sistema deve permitir ao utilizador cancelar a transferência do vídeo a qualquer instante antes da sua conclusão, purgando os dados temporários transmitidos.; Evolução: Novo")], [#should], [#text("NOVO")], [#text("UC-VID-000 (FA2)")], [#text("Concede ao utilizador a liberdade de desistir de transferências longas ou incorretas sem deixar lixo no servidor.")], [#text("Dado um upload ativo aos 50%, Quando o utilizador clica em Cancelar, Então a ligação HTTP é cortada e os blocos temporários no storage são eliminados de imediato.")],
