    [#text("REQ-VID-TRIM-010")], [#text("O sistema deve gerar o resultado do recorte em MP4 (H.264/AAC), copiando as streams sem recodificação quando a origem já utiliza H.264/AAC.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-001 (Passos 5-6, RN3, DQ-002, DQ-013)")], [#text("Garante um formato de saída uniforme e evita recodificação desnecessária.")], [#text("Dado um MP4 de origem com H.264/AAC, Quando recortado, Então as streams são copiadas; dado um AVI com MPEG-4 Part 2/MP3, Então o resultado é MP4 H.264/AAC.")],
    [#text("REQ-VID-UPLOAD-001")], [#text("O sistema deve permitir ao utilizador registado ou premium carregar um ficheiro de vídeo através da seleção manual no explorador de ficheiros local.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passos 1-2)")], [#text("Mecanismo elementar de ingestão de ficheiros multimédia a partir do dispositivo do utilizador.")], [#text("Dado um utilizador no ecrã do projeto, Quando clica em \"Carregar Vídeo\" e seleciona um ficheiro local, Então o ficheiro é colocado na fila de carregamento da interface.")],
    [#text("REQ-VID-UPLOAD-002")], [#text("O sistema deve permitir ao utilizador registado ou premium carregar um ficheiro de vídeo arrastando-o diretamente para a área de carregamento do projeto (drag-and-drop).; Evolução: Novo")], [#should], [#text("NOVO")], [#text("UC-VID-000 (FA1)")], [#text("Melhora a produtividade e a usabilidade do utilizador na gestão de conteúdos do projeto.")], [#text("Dado um ficheiro de vídeo arrastado sobre a janela do navegador, Quando largado na área do projeto, Então o sistema deteta o evento e inicia a validação preliminar.")],
    [#text("REQ-VID-UPLOAD-003")], [#text("O sistema deve validar no navegador as extensões .mp4, .mov e .avi do ficheiro selecionado antes de iniciar a transferência.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 2, Exceção 1, RN3, DQ-002)")], [#text("Impede a transmissão desnecessária de ficheiros que manifestamente não constituem vídeos MP4, MOV ou AVI.")], [#text("Dado a seleção de um ficheiro com extensão .mkv ou .webm, Quando analisado no cliente, Então o sistema bloqueia o início do upload; ficheiros .mp4, .mov e .avi são aceites.")],
    [#text("REQ-VID-UPLOAD-020")], [#text("O sistema deve validar no navegador os tipos MIME video/mp4, video/quicktime e video/x-msvideo do ficheiro selecionado antes de iniciar a transferência.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 2, Exceção 1, RN3, DQ-002)")], [#text("Confirma o tipo multimédia declarado pelo ficheiro para impedir o envio de tipos não suportados.")], [#text("Dado um ficheiro com tipo MIME não suportado, Quando analisado no cliente, Então o início do upload é bloqueado; os tipos video/mp4, video/quicktime e video/x-msvideo são aceites.")],
    [#text("REQ-VID-UPLOAD-004")], [#text("O sistema deve rejeitar o carregamento de qualquer vídeo cujo tamanho de ficheiro ultrapasse o limite do perfil do utilizador (≤ 200 MB Registado, ≤ 2 GB Premium).; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 4, Exceção 2, RN4, DQ-005)")], [#text("Protege os volumes de rede e o armazenamento de objetos contra sobrecarga e esgotamento.")], [#text("Dado um utilizador registado com ficheiro de 250 MB, Quando tenta carregar o vídeo, Então a transferência é imediatamente impedida informando o limite de 200 MB.")],
