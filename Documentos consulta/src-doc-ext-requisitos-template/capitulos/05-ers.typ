    [#text("REQ-VID-UPLOAD-009")], [#text("O sistema deve validar que a stream de vídeo utiliza um codec admitido para o contentor: H.264 (AVC) em MP4 e MOV; H.264 ou MPEG-4 Part 2 em AVI.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 5, Exceção 3, RN3, DQ-002)")], [#text("Requisito nuclear para garantir a descodificação pelos workers e a geração da cópia de pré-visualização.")], [#text("Dado um MP4 ou MOV com stream de vídeo HEVC/H.265 ou VP9, ou um AVI com stream MJPEG, Quando analisado na ingestão, Então o sistema rejeita o vídeo com código INVALID_CODEC.")],
    [#text("REQ-VID-UPLOAD-010")], [#text("O sistema deve validar que a stream de áudio, quando presente, utiliza um codec admitido para o contentor — AAC em MP4 e MOV; AAC ou MP3 em AVI —, aceitando ficheiros de vídeo sem áudio (silenciosos).; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 5, FA4, Exceção 3, RN3, DQ-002)")], [#text("Garante a uniformidade do padrão sonoro suportado sem impedir o carregamento de vídeos mudos de origem.")], [#text("Dado um MP4 sem faixa de áudio, um MOV com áudio AAC ou um AVI com áudio MP3, Quando inspecionado, Então o sistema valida a conformidade dos fluxos sonoros com sucesso.")],
    [#text("REQ-VID-UPLOAD-011")], [#text("O sistema deve rejeitar o carregamento de qualquer vídeo cuja duração total exceda o limite estipulado para o perfil ativo (≤ 5 min Registado, ≤ 60 min Premium).; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 5, Exceção 4, RN4, DQ-005)")], [#text("Evita a submissão de vídeos excessivamente longos que sobrecarregariam os workers de processamento.")], [#text("Dado um utilizador registado com vídeo de 05:15, Quando a duração é extraída, Então o vídeo é descartado com aviso de duração máxima excedida (máx. 5 minutos).")],
    [#text("REQ-VID-UPLOAD-012")], [#text("O sistema deve rejeitar ficheiros de vídeo com cabeçalhos corrompidos ou fluxos truncados, eliminando os dados e notificando o utilizador com mensagem de erro explicativa.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 5, Exceção 5, Garantia Mínima)")], [#text("Impede a entrada de binários danificados na base de dados e projetos da plataforma.")], [#text("Dado um ficheiro com assinatura MP4 mas corpo de dados truncado, Quando a inspeção falha, Então o ficheiro é removido do storage e é emitida notificação de ficheiro corrompido.")],
