    [#text("REQ-VID-TRIM-007")], [#text("O sistema deve permitir a pré-visualização em repetição (loop preview) do segmento compreendido entre o instante inicial e o instante final selecionados.; Evolução: Novo")], [#could], [#text("NOVO")], [#text("UC-VID-001 (FA1)")], [#text("Permite ao utilizador validar auditiva e visualmente o recorte pretendido antes de gastar quota.")], [#text("Dado um intervalo selecionado, Quando o utilizador clica em \"Pré-visualizar Corte\", Então o leitor integrado reproduz apenas esse trecho sem disparar tarefa.")],
    [#text("REQ-VID-TRIM-008")], [#text("O sistema deve produzir um novo ficheiro de vídeo MP4 contendo exclusivamente os fotogramas e áudio compreendidos no intervalo temporal validado.; Evolução: Refinado")], [#must], [#text("NOVO")], [#text("UC-VID-001 (Passo 6, Pós-condição de Sucesso, RN8)")], [#text("Concretiza o objetivo principal do caso de uso de recorte através do processamento assíncrono.")], [#text("Dado um vídeo original de 120 s com corte aprovado entre 00:10 e 00:40, Quando o worker conclui a tarefa, Então a duração exata do novo vídeo é de 30 segundos.")],
