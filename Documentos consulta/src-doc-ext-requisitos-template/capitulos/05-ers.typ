    [#text("REQ-VID-UPLOAD-014")], [#text("O sistema deve gerar automaticamente uma miniatura (thumbnail) em formato JPEG a partir do instante 00:00:01 do vídeo e associá-la ao recurso.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 6, RN5)")], [#text("Permite a representação visual imediata do vídeo na galeria e listagens de recursos do projeto.")], [#text("Dado a ingestão de um vídeo com sucesso, Quando o backend processa o primeiro segundo, Então uma imagem JPEG de miniatura é gerada e guardada no storage.")],
    [#text("REQ-VID-UPLOAD-015")], [#text("O sistema deve disponibilizar um reprodutor multimédia integrado com controlos de reprodução, pausa, navegação temporal (seek), volume e ecrã inteiro.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 8, RN6, A3)")], [#text("Permite ao utilizador inspecionar visualmente o conteúdo do vídeo antes de disparar qualquer transformação.")], [#text("Dado o clique num vídeo da galeria, Quando o leitor abre, Então o utilizador consegue controlar a reprodução, pausar e navegar pela linha temporal com fluidez.")],
    [#text("REQ-VID-UPLOAD-016")], [#text("O sistema deve gerar, para cada vídeo original carregado em MOV ou AVI, uma cópia de pré-visualização em MP4 (H.264/AAC) associada ao recurso.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (Passo 6, FA5, RN8, DQ-012)")], [#text("Permite reproduzir no navegador formatos que a tag HTML5 <video> não suporta de forma fiável.")], [#text("Dado o carregamento de um AVI válido, Quando a ingestão conclui, Então existe no storage uma cópia MP4 de pré-visualização associada ao recurso.")],
    [#text("REQ-VID-UPLOAD-017")], [#text("O sistema deve utilizar a cópia de pré-visualização exclusivamente no reprodutor integrado, mantendo o ficheiro original como fonte das operações de processamento e do descarregamento.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-000 (FA5, RN8), UC-VID-006 (RN7), DQ-012")], [#text("Evita perdas de qualidade em cascata e garante que o utilizador obtém sempre o ficheiro original.")], [#text("Dado um MOV com cópia de pré-visualização, Quando o utilizador o reproduz, descarrega e recorta, Então o leitor usa a cópia MP4, enquanto o descarregamento e o recorte usam o MOV original.")],
    [#text("REQ-VID-WATERMARK-001")], [#text("O sistema deve permitir ao utilizador registado ou premium escolher o tipo de marca de água entre modalidade textual e modalidade de imagem gráfica.; Evolução: Mantido")], [#must], [#text("NOVO")], [#text("UC-VID-004 (Passo 2, FA1)")], [#text("Oferece versatilidade para proteção de direitos autorais via créditos de texto ou via logótipo institucional.")], [#text("Dado o configurador de marca de água, Quando o utilizador acede à opção, Então pode alternar livremente entre as abas \"Texto\" e \"Imagem\".")],
