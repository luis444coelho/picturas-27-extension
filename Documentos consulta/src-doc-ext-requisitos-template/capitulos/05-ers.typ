    [#text("REQ-VID-SPEED-005")], [#text("O sistema deve rejeitar fatores de velocidade estritamente inferiores a 0.25× ou estritamente superiores a 4.0×.; Evolução: Mantido")], [#must], [#text("NOVO")], [#text("UC-VID-003 (Exceção 2, RN2, DQ-005)")], [#text("Limita a gama de estiramento ou compressão garantindo a estabilidade e qualidade algorítmica no MVP.")], [#text("Dado o fator 5.0×, Quando submetido, Então o sistema bloqueia o pedido indicando que o intervalo homologado é de 0.25× a 4.0×.")],
