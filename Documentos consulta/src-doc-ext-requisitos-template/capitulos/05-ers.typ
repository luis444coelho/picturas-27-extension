    [#text("REQ-VID-AUTH-002")], [#text("O sistema deve rejeitar qualquer tentativa de execução de carregamento ou operações de vídeo por utilizadores não autenticados (perfil anónimo).")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-004 (Pré-condições, RN1, DQ-001)")], [#text("O suporte a vídeo exige persistência estruturada em projetos autenticados e controlo de capacidade.")], [#text("Dado um visitante anónimo na plataforma, Quando tenta aceder às funcionalidades de vídeo, Então o sistema redireciona-o para a interface de autenticação/registo sem processar o pedido.")], [#text("Inalterado")],
    [#text("REQ-VID-AUTH-003")], [#text("O sistema deve verificar a permissão de projeto exigida pelo tipo de operação de vídeo: leitura para consultar informações ou descarregar, e edição ou propriedade para carregar ou alterar recursos.")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-013 (pré-condições e regras de autorização)")], [#text("Permite acesso de leitura aos casos de consulta e descarregamento sem autorizar alterações a recursos partilhados.")], [#text("Dado um utilizador autenticado com permissão apenas de leitura, Quando consulta informações ou descarrega um vídeo concluído, Então o pedido é autorizado; quando tenta carregar ou transformar um vídeo, Então a API responde HTTP 403 Forbidden.")], [#text("Inalterado")],
    [#text("REQ-VID-QUOTA-001")], [#text("O sistema deve verificar o saldo da quota diária de operações do utilizador registado antes de autorizar a submissão de uma tarefa de manipulação de vídeo.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Passo de confirmação, RN5, DQ-001)")], [#text("Garante o cumprimento do modelo de negócio e impede a criação de tarefas sem crédito disponível.")], [#text("Dado um utilizador registado com 0 créditos na quota diária, Quando tenta submeter uma operação de vídeo, Então a ação é bloqueada com notificação de quota esgotada.")], [#text("Inalterado")],
    [#text("REQ-VID-QUOTA-002")], [#text("O sistema deve reservar 1 crédito ao aceitar uma operação isolada ou uma junção do utilizador Registado no estado queued; a reserva de uma cadeia segue o custo total definido em REQ-VID-QUOTA-007/008.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Passo de aceitação, RN5, DQ-001)")], [#text("Evita condições de corrida e submissões concorrentes que violem o teto diário de 5 operações.")], [#text("Dado um Registado com 5 créditos, Quando uma operação isolada é aceite, Então o saldo passa a 4; quando é aceite uma cadeia de 3 passos, Então passa de 5 a 2.")], [#text("Refinado")],
    [#text("REQ-VID-QUOTA-003")], [#text("O sistema deve considerar definitivo o débito efetuado na reserva quando a tarefa atinge completed, sem novo débito nem chamada de confirmação separada.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Passo final, Pós-condição, DQ-001)")], [#text("Respeita o princípio de cobrança exclusiva por trabalhos efetivamente concluídos e entregues ao utilizador.")], [#text("Dado um custo já reservado, Quando a tarefa conclui com sucesso, Então o saldo não sofre nova alteração e não existe chamada de commit ou confirmação.")], [#text("Refinado")],
    [#text("REQ-VID-QUOTA-004")], [#text("O sistema deve devolver o total dos créditos reservados quando a tarefa do utilizador Registado falha ou é cancelada; uma rejeição anterior à reserva não altera o saldo.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Cancelamento, Exceções, RN6, DQ-001)")], [#text("Impede a penalização injusta da quota do utilizador em situações anómalas ou desistências.")], [#text("Dado uma cadeia de 3 passos com 3 créditos reservados, Quando termina em failed ou cancelled, Então são devolvidos os 3 créditos, sem publicação de resultado; dado um pedido rejeitado antes da reserva, Então o saldo permanece igual.")], [#text("Refinado")],
    [#text("REQ-VID-QUOTA-005")], [#text("O sistema deve processar todas as operações de vídeo submetidas por utilizadores com perfil Premium sem aplicar nem contabilizar quota diária de operações.")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-004 (FA Premium, RN5, DQ-001)")], [#text("Concretiza o benefício contratual de acesso e utilização ilimitada conferido aos subscritores Premium.")], [#text("Dado um utilizador autenticado com perfil Premium, Quando submete uma operação de vídeo, Então a tarefa é admitida sem verificação de quota e sem debitar contadores.")], [#text("Inalterado")],
    [#text("REQ-VID-QUOTA-006")], [#text("O sistema deve debitar a quota da operação de vídeo à conta do utilizador que executa a operação, mesmo quando este opere sobre um projeto partilhado de outro proprietário.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Pré-condições, DQ-007)")], [#text("Evita a exaustão maliciosa da quota do proprietário por convidados com acesso de edição.")], [#text("Dado um projeto partilhado pelo utilizador A com o utilizador B, Quando o utilizador B submete uma operação de vídeo, Então a quota debitada é exclusivamente a do utilizador B.")], [#text("Inalterado")],
    [#text("REQ-VID-QUOTA-007")], [#text("O sistema deve verificar, antes de aceitar um pedido com custo superior a 1 crédito (cadeia), que o saldo da quota diária do utilizador registado cobre o custo total, reservando a totalidade dos créditos no momento da aceitação.")], [#must], [#text("ALT")], [#text("UC-VID-013 (Passos 4-5, Exceção 4, RN8), DQ-013")], [#text("Evita aceitar trabalho que a quota não cobre e condições de corrida entre pedidos concorrentes.")], [#text("Dado um utilizador registado com 3 créditos, Quando submete uma cadeia de 4 passos, Então o pedido é rejeitado com QUOTA_EXCEEDED e nenhum crédito é reservado; com 5 créditos, o saldo transitório passa a 1.")], [#text("Inalterado")],
    [#text("REQ-VID-QUOTA-008")], [#text("O sistema deve calcular o custo de cada pedido de vídeo como 1 crédito por operação isolada ou junção e N créditos por cadeia de N passos, sem custo para o descarregamento e a consulta de informações.")], [#must], [#text("ALT")], [#text("UC-VID-005 (RN2), UC-VID-006 (RN2), UC-VID-012 (RN8), UC-VID-013 (RN7), DQ-013")], [#text("Estabelece uma política única e previsível de consumo de quota.")], [#text("Dado uma cadeia de 3 passos concluída, Quando a tarefa termina, Então são consumidos 3 créditos; dado um descarregamento ou uma consulta de informações, Então são consumidos 0 créditos.")], [#text("Inalterado")],
    [#text("REQ-VID-STORAGE-001")], [#text("O sistema deve armazenar os vídeos como recursos de projeto distintos de imagens, persistindo identificador único, nome de ficheiro, MIME type, duração, tamanho e data de carregamento.")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-004 (Pré-condições, Pós-condições, DQ-003)")], [#text("Modela com exatidão os atributos e características próprias de fluxos audiovisuais contínuos.")], [#text("Dado um vídeo adicionado com sucesso ao projeto, Quando consultada a base de dados, Então o documento contém campos dedicados para duração em segundos, streams e resolução.")], [#text("Inalterado")],
    [#text("REQ-VID-STORAGE-002")], [#text("O sistema deve registar no recurso de vídeo resultante a referência ao identificador único do vídeo original de proveniência (sourceVideoId) ou, quando o resultado provém de uma junção, a lista ordenada dos identificadores dos vídeos de origem (sourceVideoIds).")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004, UC-VID-007 a UC-VID-013 (Pós-condição de Sucesso, DQ-003), UC-VID-012 (Passo 7, RN10)")], [#text("Assegura a rastreabilidade completa da árvore de transformações aplicadas no projeto, incluindo resultados com várias origens.")], [#text("Dado um vídeo produzido por alteração de velocidade, Quando inspecionados os seus metadados, Então o campo sourceVideoId coincide com o identificador do vídeo de origem; dado um vídeo resultante da junção de V1 e V2, Então o campo sourceVideoIds contém [V1, V2] por essa ordem.")], [#text("Inalterado")],
    [#text("REQ-VID-STORAGE-003")], [#text("O sistema deve aplicar aos recursos de vídeo as mesmas permissões em vigor para os restantes recursos do projeto.")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-004 (Pós-condições, RN de retenção, DQ-006)")], [#text("Garante uniformidade e conformidade de privacidade no ciclo de vida dos dados da plataforma.")], [#text("Dado um utilizador sem permissão de leitura sobre o projeto, Quando tenta aceder a um vídeo desse projeto, Então o acesso é rejeitado segundo a política existente.")], [#text("Inalterado")],
    [#text("REQ-VID-STORAGE-005")], [#text("O sistema deve aplicar aos recursos de vídeo as mesmas políticas de retenção e eliminação em vigor para os restantes recursos do projeto.")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-004 (Pós-condições, RN de retenção, DQ-006)")], [#text("Garante uniformidade no ciclo de vida e na privacidade dos dados.")], [#text("Dado um utilizador que elimina um projeto, Quando a eliminação é confirmada, Então os vídeos, miniaturas e artefactos associados são purgados do storage e da base de dados.")], [#text("Inalterado")],
    [#text("REQ-VID-STORAGE-004")], [#text("O sistema deve registar nos metadados do vídeo resultante de uma cadeia ou junção a descrição ordenada dos passos aplicados, incluindo os parâmetros de cada passo e a posição de cada vídeo de origem na junção.")], [#should], [#text("NOVO")], [#text("UC-VID-012 (Passo 7), UC-VID-013 (Passo 7), UC-VID-006 (FA1), DQ-003")], [#text("Complementa a lista sourceVideoIds com a receita completa da edição, permitindo auditar e reproduzir o resultado.")], [#text("Dado o vídeo final de uma composição (V1 + filtro) + (V2 + remover áudio) → junção → marca de água, Quando inspecionados os metadados, Então constam as sub-cadeias com os seus parâmetros, a junção com a ordem (V1, V2) e a marca de água.")], [#text("Inalterado")],
    [#text("REQ-VID-TASK-001")], [#text("O sistema deve admitir operações de transformação de vídeo como tarefas assíncronas e devolver HTTP 202 com taskId e estado queued após a persistência e publicação do pedido; o tempo de aceitação segue REQ-VID-NFR-004.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Passo de criação de tarefa, RN7, DQ-004)")], [#text("Desacopla o gateway HTTP da latência de codificação e descodificação de vídeo.")], [#text("Dado um pedido válido e admitido, Quando a API responde, Então devolve HTTP 202 com taskId e status queued; a execução e o resultado final são acompanhados separadamente.")], [#text("Refinado")],
    [#text("REQ-VID-TASK-002")], [#text("O sistema deve manter as tarefas nos estados queued, processing, completed, failed ou cancelled, admitindo queued → processing/failed/cancelled e processing → completed/failed/cancelled, sem reativar estados finais.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Passos 5-6, Máquina de estados, DQ-004)")], [#text("Estabelece uma máquina de estados finitos determinística partilhada por backend, workers e frontend.")], [#text("Dado uma tarefa queued ou processing, Quando ocorre cancelamento autorizado, Então passa a cancelled; dado completed, failed ou cancelled, Quando chega uma mensagem tardia, Então o estado final não é reativado. Uma reentrega pode reiniciar a execução mantendo processing.")], [#text("Refinado")],
    [#text("REQ-VID-TASK-003")], [#text("O sistema deve emitir as notificações de transição de estado das tarefas de vídeo para o cliente através do canal WebSocket associado ao projeto.")], [#must], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (Notificação, DQ-004)")], [#text("Atualiza a interface do utilizador em tempo real sem sobrecarga de pedidos contínuos de polling HTTP.")], [#text("Dado um cliente com WebSocket conectado ao projeto, Quando a tarefa transita de queued para processing, Então é entregue de imediato uma mensagem JSON com o novo estado.")], [#text("Inalterado")],
    [#text("REQ-VID-TASK-004")], [#text("O sistema deve permitir ao utilizador que submeteu a tarefa solicitar o seu cancelamento enquanto esta se encontrar no estado queued ou processing.")], [#should], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (FA de cancelamento, DQ-004)")], [#text("Dá autonomia ao utilizador para suspender tarefas longas disparadas por lapso.")], [#text("Dado um processamento de vídeo em execução, Quando o utilizador clica em Cancelar, Então o cliente despacha pedido de cancelamento e o sistema regista a ordem de interrupção.")], [#text("Inalterado")],
    [#text("REQ-VID-TASK-005")], [#text("O sistema deve interromper a execução do worker de vídeo e eliminar os ficheiros temporários intermédios quando o cancelamento da tarefa for confirmado.")], [#should], [#text("ALT")], [#text("UC-VID-001 a UC-VID-004 (FA de cancelamento, Garantia Mínima, DQ-004)")], [#text("Liberta capacidade computacional e impede a acumulação de artefactos órfãos no disco do servidor.")], [#text("Dado um cancelamento validado pelo sistema, Quando o worker recebe a instrução, Então suspende a instância FFmpeg e purga os fragmentos gerados no diretório de trabalho.")], [#text("Inalterado")],
    [#text("REQ-VID-TASK-006")], [#text("O sistema deve manter um estado agregado único para uma tarefa composta por vários passos, segundo a máquina de estados canónica.")], [#must], [#text("ALT")], [#text("UC-VID-013 (Passos 5-6, RN9), DQ-015")], [#text("Estende a máquina de estados existente às cadeias de operações sem a alterar.")], [#text("Dado uma cadeia de operações em execução, Quando consultado o estado da tarefa, Então é devolvido um único estado agregado da máquina canónica.")], [#text("Inalterado")],
    [#text("REQ-VID-TASK-007")], [#text("O sistema deve registar o passo corrente e o número total de passos numa tarefa composta.")], [#must], [#text("ALT")], [#text("UC-VID-013 (Passos 5-6, RN9), DQ-015")], [#text("Permite identificar o avanço da cadeia durante a execução.")], [#text("Dado uma cadeia de 4 passos em execução no terceiro passo, Quando consultado o detalhe da tarefa, Então indica step: 3 e totalSteps: 4.")], [#text("Inalterado")],
    [#text("REQ-VID-ERROR-001")], [#text("O sistema deve emitir mensagens de erro com categoria estável e instrução corretiva perante qualquer falha de validação, limites, quota ou processamento.")], [#must], [#text("ALT")], [#text("UC-VID-000 a UC-VID-004 (Exceções de todos os casos)")], [#text("Assegura que o utilizador compreende a razão precisa do insucesso e identifica como proceder para corrigir.")], [#text("Dado o envio de um ficheiro com formato incompatível, Quando a resposta é devolvida ao utilizador, Então contém código semântico estável e mensagem explicativa clara.")], [#text("Inalterado")],
    [#text("REQ-VID-ERROR-002")], [#text("O sistema deve registar nos logs internos o identificador de correlação (correlationId) e a causa técnica exata de falhas de processamento sem expor dados sensíveis ao utilizador.")], [#must], [#text("NOVO")], [#text("UC-VID-000 a UC-VID-004 (Exceções de processamento, REQ-VID-NFR-002)")], [#text("Permite auditoria técnica e diagnóstico célere de incidentes garantindo a privacidade e segurança do sistema.")], [#text("Dado um erro interno no worker FFmpeg, Quando analisados os logs centrais, Então o erro surge catalogado com o respetivo correlationId enquanto o utilizador recebe mensagem amigável.")], [#text("Inalterado")],
    [#text("REQ-VID-ERROR-003")], [#text("O sistema deve assegurar a limpeza automática de ficheiros temporários e objetos órfãos no storage sempre que ocorrer uma falha não recuperável de processamento.")], [#must], [#text("NOVO")], [#text("UC-VID-000 a UC-VID-004 (Garantia Mínima, DQ-006)")], [#text("Evita a degradação e ocupação descontrolada da capacidade de armazenamento do SeaweedFS/S3.")], [#text("Dado um encerramento inesperado do processo de encoding, Quando a rotina de recuperação atua, Então qualquer ficheiro temporário gerado é eliminado do volume de storage.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-001")], [#text("O sistema deve permitir ao utilizador registado ou premium selecionar dois ou mais vídeos do projeto para junção, incluindo o mesmo vídeo mais do que uma vez.")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passos 1-2, FA2, RN2)")], [#text("Concretiza a seleção dos clips a concatenar.")], [#text("Dado um projeto com os vídeos V1, V2 e V3, Quando o utilizador seleciona V1, V3 e V1, Então os três clips surgem na linha temporal por essa ordem.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-002")], [#text("O sistema deve apresentar os clips selecionados na linha temporal pela ordem de seleção.")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passos 2-3, RN4)")], [#text("O utilizador controla a ordem do vídeo final.")], [#text("Dado que o utilizador seleciona V1, V2 e V3, Quando a linha temporal é apresentada, Então os clips surgem pela ordem V1, V2, V3.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-013")], [#text("O sistema deve permitir reordenar os clips na linha temporal antes da confirmação da junção.")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passos 2-3, RN4)")], [#text("Permite ao utilizador definir a sequência pretendida para o resultado.")], [#text("Dado uma linha temporal V1, V2, V3, Quando o utilizador move V3 para a primeira posição, Então a ordem passa a V3, V1, V2.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-003")], [#text("O sistema deve permitir remover um clip da linha temporal antes da confirmação.")], [#should], [#text("NOVO")], [#text("UC-VID-012 (FA1)")], [#text("Permite corrigir a seleção sem recomeçar.")], [#text("Dado a linha temporal V1, V2, V3, Quando o utilizador remove V2, Então a linha temporal passa a V1, V3 e a duração total é recalculada.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-004")], [#text("O sistema deve apresentar em tempo real a duração total estimada do resultado da junção.")], [#should], [#text("NOVO")], [#text("UC-VID-012 (Passos 2-3, RN5)")], [#text("Dá previsibilidade sobre o resultado e sobre a proximidade ao limite do perfil.")], [#text("Dado clips com durações de 20 s, 35 s e 10 s, Quando selecionados, Então a interface indica uma duração estimada de 65 s.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-012")], [#text("O sistema deve apresentar a resolução e a taxa de fotogramas estimadas do resultado da junção.")], [#should], [#text("NOVO")], [#text("UC-VID-012 (Passos 2-3, RN5)")], [#text("Dá previsibilidade sobre as propriedades do vídeo resultante.")], [#text("Dado clips em que o primeiro tem 1280×720 a 30 fps, Quando a seleção é feita, Então a interface indica 1280×720 a 30 fps como propriedades estimadas do resultado.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-005")], [#text("O sistema deve rejeitar pedidos de junção com menos de dois clips.")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passo 4, Exceção 1, RN2)")], [#text("Uma junção com um único clip não tem efeito.")], [#text("Dado um pedido via API com um único clip, Quando submetido, Então a API responde HTTP 422 com INSUFFICIENT_INPUTS.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-006")], [#text("O sistema deve rejeitar pedidos de junção com mais clips do que o limite do perfil (10 Registado, 50 Premium).")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passo 4, Exceção 2, FA5, RN2, DQ-014)")], [#text("Protege os workers e o armazenamento contra composições excessivas.")], [#text("Dado um utilizador registado, Quando submete uma junção com 11 clips, Então a API responde HTTP 422 com TOO_MANY_INPUTS indicando o limite de 10.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-007")], [#text("O sistema deve rejeitar pedidos de junção cuja duração total exceda o limite de duração do perfil (5 min Registado, 60 min Premium).")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passo 4, Exceção 3, RN3, REQ-VID-NFR-007)")], [#text("Mantém o resultado dentro dos limites aplicáveis a qualquer vídeo do perfil.")], [#text("Dado um utilizador registado com clips de 3 min e 2 min 30 s, Quando submete a junção, Então a API responde HTTP 422 com LIMIT_EXCEEDED (5 min 30 s > 5 min).")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-008")], [#text("O sistema deve normalizar cada clip para a resolução e a taxa de fotogramas do primeiro clip, acrescentando barras pretas quando a proporção difere.")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passo 6, RN5, DQ-018)")], [#text("Permite concatenar clips heterogéneos num fluxo contínuo e sem distorção.")], [#text("Dado um primeiro clip 1920×1080 a 30 fps e um segundo 1080×1920 a 25 fps, Quando a junção conclui, Então todo o resultado está em 1920×1080 a 30 fps e o segundo clip surge centrado com barras laterais.")], [#text("Inalterado")],
    [#text("REQ-VID-CONCAT-009")], [#text("O sistema deve acrescentar uma faixa de silêncio, com a duração do clip, a cada clip sem stream de áudio.")], [#must], [#text("NOVO")], [#text("UC-VID-012 (Passo 6, RN6)")], [#text("Mantém a sincronização entre áudio e vídeo ao longo de todo o resultado.")], [#text("Dado um clip silencioso de 10 s entre dois clips com áudio, Quando a junção conclui, Então o resultado tem uma única stream de áudio contínua com 10 s de silêncio nessa posição.")], [#text("Inalterado")],
