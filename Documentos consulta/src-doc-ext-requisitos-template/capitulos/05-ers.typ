    [#text("REQ-VID-CHAIN-005")], [#text("O sistema deve permitir incluir um passo de junção, acrescentando outros vídeos do projeto como clips, cada um com uma sub-cadeia própria (possivelmente vazia) aplicada antes da junção.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (FA1, RN4), UC-VID-013 (FA6)")], [#text("Permite editar cada clip de forma diferente antes de os juntar, num único fluxo.")], [#text("Dado V1, V2 e V3, Quando o utilizador define (V1 + filtro de cor), (V2 + remover áudio) e (V3 + acelerar) seguidos de junção, Então a cadeia apresenta as três sub-cadeias ligadas ao passo de junção.")],
    [#text("REQ-VID-CHAIN-006")], [#text("O sistema deve aplicar os passos definidos depois da junção ao resultado da junção.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (FA1, RN4)")], [#text("Permite operações finais sobre o vídeo composto (e.g. marca de água única).")], [#text("Dado a composição do exemplo seguida de \"marca de água\", Quando a cadeia conclui, Então o vídeo final contém os três clips editados e a marca de água em todos os fotogramas.")],
    [#text("REQ-VID-CHAIN-007")], [#text("O sistema deve rejeitar cadeias vazias.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passo 4, Exceção 2, RN2-RN3, DQ-017)")], [#text("Garante uma estrutura executável e coerente com o formato de trabalho.")], [#text("Dado uma cadeia sem passos, Quando o utilizador confirma, Então o pedido é rejeitado com INVALID_CHAIN.")],
    [#text("REQ-VID-CHAIN-016")], [#text("O sistema deve rejeitar uma cadeia em que a conversão de formato não seja o último passo.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passo 4, Exceção 2, RN2-RN3, DQ-017)")], [#text("Mantém a conversão final como etapa de codificação do resultado.")], [#text("Dado uma cadeia em que a conversão não é o último passo, Quando confirmada, Então é rejeitada com INVALID_CHAIN.")],
    [#text("REQ-VID-CHAIN-017")], [#text("O sistema deve rejeitar uma cadeia que contenha mais de uma junção.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passo 4, Exceção 2, RN2-RN3, DQ-017)")], [#text("Evita estruturas de composição ambíguas no MVP.")], [#text("Dado uma cadeia com duas junções, Quando confirmada, Então é rejeitada com INVALID_CHAIN.")],
    [#text("REQ-VID-CHAIN-018")], [#text("O sistema deve rejeitar uma cadeia que contenha extração de fotogramas.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passo 4, Exceção 2, RN2-RN3, DQ-017)")], [#text("A extração produz imagens e não integra a cadeia de transformações de vídeo.")], [#text("Dado uma cadeia com extração de fotogramas, Quando confirmada, Então é rejeitada com INVALID_CHAIN.")],
    [#text("REQ-VID-CHAIN-008")], [#text("O sistema deve impedir que uma cadeia ultrapasse 10 passos no total, contando sub-cadeias, junção e passos finais.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passo 3, Exceção 3, RN5, DQ-015, REQ-VID-NFR-014)")], [#text("Limita a complexidade e o tempo de processamento de cada tarefa.")], [#text("Dado uma cadeia com 10 passos, Quando o utilizador tenta adicionar o 11.º, Então a ação é bloqueada com CHAIN_TOO_LONG.")],
    [#text("REQ-VID-CHAIN-009")], [#text("O sistema deve apresentar, antes da confirmação, o custo total da cadeia em créditos, igual ao número total de passos (a junção conta 1).; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passos 1-3, RN7, DQ-014, REQ-VID-QUOTA-008)")], [#text("Dá transparência sobre o consumo de quota antes de o utilizador se comprometer.")], [#text("Dado a composição do exemplo (3 passos por clip + junção + marca de água), Quando apresentada, Então o custo indicado é de 5 créditos.")],
    [#text("REQ-VID-CHAIN-010")], [#text("O sistema deve executar a cadeia completa numa única tarefa assíncrona, que conta como uma tarefa ativa no projeto.; Evolução: Novo")], [#must], [#text("ALT")], [#text("UC-VID-014 (Passos 4-6, RN9, DQ-016, REQ-VID-TASK-006)")], [#text("Simplifica o acompanhamento e respeita o limite de concorrência por projeto.")], [#text("Dado uma cadeia de 4 passos confirmada, Quando a API responde, Então é devolvido um único taskId e o projeto tem uma única tarefa ativa.")],
    [#text("REQ-VID-CHAIN-011")], [#text("O sistema deve gravar no projeto apenas o vídeo final da cadeia, purgando os resultados intermédios no fim da tarefa.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Passo 7, RN10)")], [#text("Evita poluir o projeto e o armazenamento com versões intermédias.")], [#text("Dado uma cadeia de 3 passos concluída, Quando consultada a galeria e o armazenamento, Então existe apenas um novo vídeo e nenhum ficheiro intermédio.")],
    [#text("REQ-VID-CHAIN-012")], [#text("O sistema deve emitir via WebSocket o passo corrente (k de N) e o progresso percentual global da cadeia.; Evolução: Novo")], [#should], [#text("ALT")], [#text("UC-VID-014 (Passo 6, REQ-VID-TASK-006, REQ-VID-NFR-009)")], [#text("Dá visibilidade sobre a execução de tarefas longas e compostas.")], [#text("Dado uma cadeia de 4 passos em execução, Quando o segundo passo inicia, Então o cliente recebe um evento com step: 2, totalSteps: 4 e a percentagem global.")],
    [#text("REQ-VID-CHAIN-013")], [#text("O sistema deve tratar a cadeia de forma atómica, não gravando qualquer resultado e devolvendo todos os créditos reservados se algum passo falhar ou a cadeia for cancelada.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-014 (Exceção 7, FA4-FA5, Garantia Mínima, RN8, RN11, DQ-018)")], [#text("Evita resultados que não correspondem à edição pedida e penalizações injustas de quota.")], [#text("Dado uma cadeia de 3 passos que falha no terceiro, Quando a tarefa transita para failed, Então nenhum vídeo novo surge no projeto e os 3 créditos são devolvidos.")],
    [#text("REQ-VID-CHAIN-014")], [#text("O sistema deve permitir guardar uma cadeia sem junção como predefinição com nome, reutilizável em novas cadeias e em lotes.; Evolução: Novo")], [#could], [#text("NOVO")], [#text("UC-VID-014 (FA3), UC-VID-015 (FA3)")], [#text("Evita reconfigurar sequências usadas com frequência.")], [#text("Dado uma cadeia \"720p + marca de água\" guardada, Quando o utilizador abre um lote, Então pode carregar a predefinição com todos os parâmetros preenchidos.")],
    [#text("REQ-VID-COM-001")], [#text("O sistema deve permitir iniciar uma operação de manipulação de vídeo apenas para um recurso de vídeo previamente carregado, íntegro e associado ao projeto do utilizador autenticado.; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (Pré-condições)")], [#text("Porta de entrada de segurança e integridade de dados para todo o subsistema de vídeo.")], [#text("Dado um utilizador autenticado, Quando submete um pedido de operação para um ID de vídeo inexistente ou pertencente a outro projeto, Então o pedido é rejeitado com código HTTP 404 ou 403 sem criar tarefa.")],
    [#text("REQ-VID-COM-002")], [#text("O sistema deve disponibilizar o resultado de qualquer operação de vídeo apenas após a conclusão bem-sucedida da respetiva tarefa de processamento assíncrono.; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Pós-condição de Sucesso)")], [#text("Evita a exposição de ficheiros corrompidos ou incompletos na galeria do utilizador.")], [#text("Dado um processamento assíncrono em curso, Quando o utilizador consulta a galeria do projeto, Então nenhum artefacto temporário ou parcial é visível até à receção do estado completed.")],
    [#text("REQ-VID-COM-003")], [#text("O sistema deve associar automaticamente o vídeo resultante ao projeto como novo recurso independente após a conclusão bem-sucedida do processamento.; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-001 a 004 (Passo final, Pós-condição, DQ-007)")], [#text("Garante a persistência não destrutiva do resultado mantendo o histórico de transformações do projeto.")], [#text("Dado o término com sucesso de uma operação de vídeo, Quando o processamento atinge completed, Então o novo recurso surge listado no projeto com metadados preenchidos e vínculo ao vídeo de origem.")],
    [#text("REQ-VID-COM-004")], [#text("O sistema deve validar todos os parâmetros de uma operação de vídeo na camada de API antes de registar a tarefa de processamento na fila assíncrona.; Evolução: Mantido")], [#must], [#text("NOVO")], [#text("UC-VID-001 a 005 (Passos de validação)")], [#text("Impede o consumo inútil de ciclos de computação nos workers com pedidos malformados ou incompletos.")], [#text("Dado um conjunto de parâmetros introduzidos na interface, Quando o utilizador confirma a operação, Então a API valida tipos e limites antes de publicar mensagem no broker RabbitMQ.")],
    [#text("REQ-VID-COM-005")], [#text("O sistema deve rejeitar a criação da tarefa de processamento quando algum parâmetro for inválido, indicando o campo em falta ou incorreto.; Evolução: Mantido")], [#must], [#text("NOVO")], [#text("UC-VID-001 a 005 (Exceções de parâmetros)")], [#text("Facilita a usabilidade e a rápida correção por parte do utilizador sem qualquer débito de quota.")], [#text("Dado um formulário com parâmetro fora dos limites suportados, Quando o utilizador submete a operação, Então a API responde com código HTTP 422 indicando o atributo causador da violação.")],
    [#text("REQ-VID-COM-006")], [#text("O sistema deve expor todas as operações de transformação de vídeo através de um contrato uniforme de tipo de operação e parâmetros, que permita executá-las isoladamente, como passo de uma cadeia ou em lote.; Evolução: Novo")], [#must], [#text("NOVO")], [#text("UC-VID-008 a 012 (FA de utilização em cadeia/lote), UC-VID-014 (RN2), UC-VID-015 (RN3), DQ-017")], [#text("Permite compor operações sem implementações específicas por contexto de execução.")], [#text("Dado o contrato {operation, parameters} de um filtro, Quando submetido isoladamente, como passo de cadeia ou num lote, Então é validado pelas mesmas regras e produz o mesmo efeito.")],
    [#text("REQ-VID-AUTH-001")], [#text("O sistema deve exigir um token JWT válido para autorizar a invocação de qualquer endpoint do subsistema de vídeo (upload ou manipulação).; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (Pré-condições, RN1, DQ-001)")], [#text("Protege as rotas da API contra acessos indevidos e assegura a identificação inequívoca do utilizador responsável.")], [#text("Dado um pedido HTTP sem cabeçalho Authorization ou com token expirado, Quando submetido a qualquer rota de vídeo, Então o sistema devolve imediatamente o código HTTP 401 Unauthorized.")],
    [#text("REQ-VID-AUTH-002")], [#text("O sistema deve rejeitar qualquer tentativa de execução de carregamento ou operações de vídeo por utilizadores não autenticados (perfil anónimo).; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (Pré-condições, RN1, DQ-001)")], [#text("O suporte a vídeo exige persistência estruturada em projetos autenticados e controlo de capacidade.")], [#text("Dado um visitante anónimo na plataforma, Quando tenta aceder às funcionalidades de vídeo, Então o sistema redireciona-o para a interface de autenticação/registo sem processar o pedido.")],
    [#text("REQ-VID-AUTH-003")], [#text("O sistema deve verificar a permissão de projeto exigida pelo tipo de operação de vídeo: leitura para consultar informações ou descarregar, e edição ou propriedade para carregar ou alterar recursos.; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-000 a 015 (pré-condições e regras de autorização)")], [#text("Permite acesso de leitura aos casos de consulta e descarregamento sem autorizar alterações a recursos partilhados.")], [#text("Dado um utilizador autenticado com permissão apenas de leitura, Quando consulta informações ou descarrega um vídeo concluído, Então o pedido é autorizado; quando tenta carregar ou transformar um vídeo, Então a API responde HTTP 403 Forbidden.")],
    [#text("REQ-VID-QUOTA-001")], [#text("O sistema deve verificar o saldo da quota diária de operações do utilizador registado antes de autorizar a submissão de uma tarefa de manipulação de vídeo.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Passo de confirmação, RN5, DQ-001)")], [#text("Garante o cumprimento do modelo de negócio e impede a criação de tarefas sem crédito disponível.")], [#text("Dado um utilizador registado com 0 créditos na quota diária, Quando tenta submeter uma operação de vídeo, Então a ação é bloqueada com notificação de quota esgotada.")],
    [#text("REQ-VID-QUOTA-002")], [#text("O sistema deve reservar exatamente 1 operação da quota diária do utilizador registado no momento da aceitação da tarefa de vídeo no estado queued.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Passo de aceitação, RN5, DQ-001)")], [#text("Evita condições de corrida e submissões concorrentes que violem o teto diário de 5 operações.")], [#text("Dado um utilizador registado com saldo de 5 créditos, Quando a tarefa de vídeo é aceite em fila, Então o seu saldo transitório é decrementado para 4 créditos.")],
    [#text("REQ-VID-QUOTA-003")], [#text("O sistema deve confirmar o débito definitivo da operação de quota reservada apenas quando a tarefa atinge o estado de conclusão com sucesso (completed).; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Passo final, Pós-condição, DQ-001)")], [#text("Respeita o princípio de cobrança exclusiva por trabalhos efetivamente concluídos e entregues ao utilizador.")], [#text("Dado um processamento com crédito previamente reservado, Quando a tarefa atinge completed, Então o débito é consolidado sem decrementos adicionais.")],
    [#text("REQ-VID-QUOTA-004")], [#text("O sistema deve devolver o crédito de quota reservado ao saldo do utilizador registado em caso de cancelamento voluntário, rejeição ou falha de processamento.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Cancelamento, Exceções, RN6, DQ-001)")], [#text("Impede a penalização injusta da quota do utilizador em situações anómalas ou desistências.")], [#text("Dado um processamento que falha nos workers, Quando a tarefa transita para o estado failed, Então o saldo do utilizador registado é incrementado em 1 unidade de imediato.")],
    [#text("REQ-VID-QUOTA-005")], [#text("O sistema deve processar todas as operações de vídeo submetidas por utilizadores com perfil Premium sem aplicar nem contabilizar quota diária de operações.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (FA Premium, RN5, DQ-001)")], [#text("Concretiza o benefício contratual de acesso e utilização ilimitada conferido aos subscritores Premium.")], [#text("Dado um utilizador autenticado com perfil Premium, Quando submete uma operação de vídeo, Então a tarefa é admitida sem verificação de quota e sem debitar contadores.")],
    [#text("REQ-VID-QUOTA-006")], [#text("O sistema deve debitar a quota da operação de vídeo à conta do utilizador que executa a operação, mesmo quando este opere sobre um projeto partilhado de outro proprietário.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Pré-condições, DQ-008)")], [#text("Evita a exaustão maliciosa da quota do proprietário por convidados com acesso de edição.")], [#text("Dado um projeto partilhado pelo utilizador A com o utilizador B, Quando o utilizador B submete uma operação de vídeo, Então a quota debitada é exclusivamente a do utilizador B.")],
    [#text("REQ-VID-QUOTA-007")], [#text("O sistema deve verificar, antes de aceitar um pedido com custo superior a 1 crédito (cadeia ou lote), que o saldo da quota diária do utilizador registado cobre o custo total, reservando a totalidade dos créditos no momento da aceitação.; Evolução: Novo")], [#must], [#text("ALT")], [#text("UC-VID-014 (Passos 4-5, Exceção 4, RN8), UC-VID-015 (Passos 4-5, Exceção 4, RN4), DQ-014")], [#text("Evita aceitar trabalho que a quota não cobre e condições de corrida entre pedidos concorrentes.")], [#text("Dado um utilizador registado com 3 créditos, Quando submete uma cadeia de 4 passos, Então o pedido é rejeitado com QUOTA_EXCEEDED e nenhum crédito é reservado; com 5 créditos, o saldo transitório passa a 1.")],
    [#text("REQ-VID-QUOTA-008")], [#text("O sistema deve calcular o custo de cada pedido de vídeo como 1 crédito por operação isolada ou junção, N créditos por cadeia de N passos e, num lote, o custo da operação ou cadeia multiplicado pelo número de vídeos concluídos, sem custo para o descarregamento e a consulta de informações.; Evolução: Novo")], [#must], [#text("ALT")], [#text("UC-VID-006 (RN2), UC-VID-007 (RN2), UC-VID-013 (RN8), UC-VID-014 (RN7), UC-VID-015 (RN4), DQ-014")], [#text("Estabelece uma política única e previsível de consumo de quota para todas as operações de vídeo.")], [#text("Dado uma cadeia de 3 passos aplicada em lote a 2 vídeos concluídos, Quando o lote termina, Então são debitados 6 créditos; dado um descarregamento ou uma consulta de informações, Então são debitados 0 créditos.")],
    [#text("REQ-VID-STORAGE-001")], [#text("O sistema deve armazenar os vídeos como recursos de projeto distintos de imagens, persistindo identificador único, nome de ficheiro, MIME type, duração, tamanho e data de carregamento.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (Pré-condições, Pós-condições, DQ-003)")], [#text("Modela com exatidão os atributos e características próprias de fluxos audiovisuais contínuos.")], [#text("Dado um vídeo adicionado com sucesso ao projeto, Quando consultada a base de dados, Então o documento contém campos dedicados para duração em segundos, streams e resolução.")],
    [#text("REQ-VID-STORAGE-002")], [#text("O sistema deve registar no recurso de vídeo resultante a referência ao identificador único do vídeo original de proveniência (sourceVideoId) ou, quando o resultado provém de uma junção, a lista ordenada dos identificadores dos vídeos de origem (sourceVideoIds).; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-001 a 004, UC-VID-008 a 015 (Pós-condição de Sucesso, DQ-003), UC-VID-013 (Passo 7, RN10)")], [#text("Assegura a rastreabilidade completa da árvore de transformações aplicadas no projeto, incluindo resultados com várias origens.")], [#text("Dado um vídeo produzido por alteração de velocidade, Quando inspecionados os seus metadados, Então o campo sourceVideoId coincide com o identificador do vídeo de origem; dado um vídeo resultante da junção de V1 e V2, Então o campo sourceVideoIds contém [V1, V2] por essa ordem.")],
    [#text("REQ-VID-STORAGE-003")], [#text("O sistema deve aplicar aos recursos de vídeo as mesmas permissões em vigor para os restantes recursos do projeto.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (Pós-condições, RN de retenção, DQ-007)")], [#text("Garante uniformidade e conformidade de privacidade no ciclo de vida dos dados da plataforma.")], [#text("Dado um utilizador sem permissão de leitura sobre o projeto, Quando tenta aceder a um vídeo desse projeto, Então o acesso é rejeitado segundo a política existente.")],
    [#text("REQ-VID-STORAGE-005")], [#text("O sistema deve aplicar aos recursos de vídeo as mesmas políticas de retenção e eliminação em vigor para os restantes recursos do projeto.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-000 a 005 (Pós-condições, RN de retenção, DQ-007)")], [#text("Garante uniformidade no ciclo de vida e na privacidade dos dados.")], [#text("Dado um utilizador que elimina um projeto, Quando a eliminação é confirmada, Então os vídeos, miniaturas e artefactos associados são purgados do storage e da base de dados.")],
    [#text("REQ-VID-STORAGE-004")], [#text("O sistema deve registar nos metadados do vídeo resultante de uma cadeia ou junção a descrição ordenada dos passos aplicados, incluindo os parâmetros de cada passo e a posição de cada vídeo de origem na junção.; Evolução: Novo")], [#should], [#text("NOVO")], [#text("UC-VID-013 (Passo 7), UC-VID-014 (Passo 7), UC-VID-007 (FA1), DQ-003")], [#text("Complementa a lista sourceVideoIds com a receita completa da edição, permitindo auditar e reproduzir o resultado.")], [#text("Dado o vídeo final de uma composição (V1 + filtro) + (V2 + remover áudio) → junção → marca de água, Quando inspecionados os metadados, Então constam as sub-cadeias com os seus parâmetros, a junção com a ordem (V1, V2) e a marca de água.")],
    [#text("REQ-VID-TASK-001")], [#text("O sistema deve executar as operações de vídeo através de tarefas assíncronas, devolvendo resposta HTTP inicial imediata com o identificador da tarefa e estado queued.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Passo de criação de tarefa, RN7, DQ-004)")], [#text("Desacopla o gateway HTTP da latência de codificação e descodificação de vídeo.")], [#text("Dado o envio de um pedido válido de recorte de vídeo, Quando a API responde, Então o tempo de resposta HTTP é inferior a 1 segundo e o corpo JSON contém taskId e status: \"queued\".")],
    [#text("REQ-VID-TASK-002")], [#text("O sistema deve orquestrar o ciclo de vida das tarefas de vídeo segundo os estados formais queued, processing, completed, failed e cancelled.; Evolução: Refinado")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Passos 5-6, Máquina de estados, DQ-004)")], [#text("Estabelece uma máquina de estados finitos determinística partilhada por backend, workers e frontend.")], [#text("Dado o registo de uma tarefa, Quando o fluxo de execução decorre, Então as transições de estado obedecem rigorosamente à ordem canónica sem saltos temporais inconsistentes.")],
    [#text("REQ-VID-TASK-003")], [#text("O sistema deve emitir as notificações de transição de estado das tarefas de vídeo para o cliente através do canal WebSocket associado ao projeto.; Evolução: Mantido")], [#must], [#text("ALT")], [#text("UC-VID-001 a 005 (Notificação, DQ-004)")], [#text("Atualiza a interface do utilizador em tempo real sem sobrecarga de pedidos contínuos de polling HTTP.")], [#text("Dado um cliente com WebSocket conectado ao projeto, Quando a tarefa transita de queued para processing, Então é entregue de imediato uma mensagem JSON com o novo estado.")],
    [#text("REQ-VID-TASK-004")], [#text("O sistema deve permitir ao utilizador que submeteu a tarefa solicitar o seu cancelamento enquanto esta se encontrar no estado queued ou processing.; Evolução: Mantido")], [#should], [#text("ALT")], [#text("UC-VID-001 a 005 (FA de cancelamento, DQ-004)")], [#text("Dá autonomia ao utilizador para suspender tarefas longas disparadas por lapso.")], [#text("Dado um processamento de vídeo em execução, Quando o utilizador clica em Cancelar, Então o cliente despacha pedido de cancelamento e o sistema regista a ordem de interrupção.")],
    [#text("REQ-VID-TASK-005")], [#text("O sistema deve interromper a execução do worker de vídeo e eliminar os ficheiros temporários intermédios quando o cancelamento da tarefa for confirmado.; Evolução: Mantido")], [#should], [#text("ALT")], [#text("UC-VID-001 a 005 (FA de cancelamento, Garantia Mínima, DQ-004)")], [#text("Liberta capacidade computacional e impede a acumulação de artefactos órfãos no disco do servidor.")], [#text("Dado um cancelamento validado pelo sistema, Quando o worker recebe a instrução, Então suspende a instância FFmpeg e purga os fragmentos gerados no diretório de trabalho.")],
